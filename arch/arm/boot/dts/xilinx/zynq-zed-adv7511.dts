// SPDX-License-Identifier: GPL-2.0
/*
 * ZedBoard with the ADI "adv7511" reference design (hdl_2023_r2) in the PL:
 * AXI HDMI TX + AXI-DMAC video path to the on-board ADV7511, S/PDIF audio
 * to the ADV7511 and I2S audio to the on-board ADAU1761.
 */
/dts-v1/;
#include "zynq-zed.dts"
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	model = "Avnet ZedBoard board with ADV7511 HDMI";

	/* ADV7511 datasheet: 1.8 V analog/digital/PLL/bandgap rails, 3.3 V DVDD_3V */
	vcc_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VCC1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	audio_clock: audio-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12288000>;
	};

	hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "HDMI monitor";
		simple-audio-card,widgets = "Speaker", "Speaker";
		simple-audio-card,routing = "Speaker", "TX";

		simple-audio-card,dai-link {
			cpu {
				sound-dai = <&axi_spdif_tx>;
			};

			codec {
				sound-dai = <&adv7511 1>;
			};
		};
	};

	zed-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ZED ADAU1761";
		simple-audio-card,widgets =
			"Microphone", "Mic In",
			"Headphone", "Headphone Out",
			"Line", "Line In",
			"Line", "Line Out";
		simple-audio-card,routing =
			"Line Out", "LOUT",
			"Line Out", "ROUT",
			"Headphone Out", "LHP",
			"Headphone Out", "RHP",
			"Mic In", "MICBIAS",
			"LINN", "Mic In",
			"RINN", "Mic In",
			"LAUX", "Line In",
			"RAUX", "Line In";

		simple-audio-card,dai-link {
			format = "i2s";

			cpu {
				sound-dai = <&axi_i2s>;
			};

			codec {
				sound-dai = <&adau1761>;
			};
		};
	};

	fpga-bus {
		compatible = "simple-bus";
		interrupt-parent = <&intc>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		axi_iic_main: i2c@41600000 {
			compatible = "xlnx,xps-iic-2.00.a";
			reg = <0x41600000 0x10000>;
			interrupts = <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkc 15>;
			#address-cells = <1>;
			#size-cells = <0>;

			adau1761: audio-codec@3b {
				compatible = "adi,adau1761";
				reg = <0x3b>;
				clocks = <&audio_clock>;
				clock-names = "mclk";
				#sound-dai-cells = <0>;
			};

			adv7511: hdmi@39 {
				compatible = "adi,adv7511";
				reg = <0x39>, <0x3f>;
				reg-names = "main", "edid";
				adi,input-depth = <8>;
				adi,input-colorspace = "yuv422";
				adi,input-clock = "1x";
				adi,input-style = <1>;
				adi,input-justification = "right";
				adi,clock-delay = <0>;
				avdd-supply = <&vcc_1v8>;
				dvdd-supply = <&vcc_1v8>;
				pvdd-supply = <&vcc_1v8>;
				bgvdd-supply = <&vcc_1v8>;
				dvdd-3v-supply = <&vcc_3v3>;
				#sound-dai-cells = <1>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						adv7511_in: endpoint {
							remote-endpoint = <&axi_hdmi_out>;
						};
					};

					port@1 {
						reg = <1>;
					};
				};
			};
		};

		hdmi_dma: dma-controller@43000000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x43000000 0x1000>;
			interrupts = <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkc 16>;
			#dma-cells = <1>;

		};

		hdmi_clock: clock-controller@79000000 {
			compatible = "adi,axi-clkgen-2.00.a";
			reg = <0x79000000 0x10000>;
			clocks = <&clkc 16>, <&clkc 15>;
			clock-names = "clkin1", "s_axi_aclk";
			#clock-cells = <0>;
		};

		axi_hdmi@70e00000 {
			compatible = "adi,axi-hdmi-tx-1.00.a";
			reg = <0x70e00000 0x10000>;
			clocks = <&hdmi_clock>;
			dmas = <&hdmi_dma 0>;
			dma-names = "video";

			port {
				axi_hdmi_out: endpoint {
					remote-endpoint = <&adv7511_in>;
				};
			};
		};

		axi_spdif_tx: axi-spdif-tx@75c00000 {
			compatible = "adi,axi-spdif-tx-1.00.a";
			reg = <0x75c00000 0x1000>;
			dmas = <&dmac_s 0>;
			dma-names = "tx";
			clocks = <&clkc 15>, <&audio_clock>;
			clock-names = "axi", "ref";
			#sound-dai-cells = <0>;
		};

		axi_i2s: axi-i2s@77600000 {
			compatible = "adi,axi-i2s-1.00.a";
			reg = <0x77600000 0x1000>;
			dmas = <&dmac_s 1>, <&dmac_s 2>;
			dma-names = "tx", "rx";
			clocks = <&clkc 15>, <&audio_clock>;
			clock-names = "axi", "ref";
			#sound-dai-cells = <0>;
		};

	};
};
